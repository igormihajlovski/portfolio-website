<aside
  class="analytics-consent"
  data-analytics-consent
  id="analytics-consent"
  role="region"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <div class="analytics-consent-copy">
    <h2 id="analytics-consent-title">Your privacy</h2>
    <p id="analytics-consent-description">
      I use analytics to understand how visitors use this website and improve its performance and experience. You can allow analytics or continue with only necessary technologies.
    </p>
    <a href="/privacy-policy/">Privacy Policy</a>
  </div>
  <div class="analytics-consent-actions">
    <button type="button" class="analytics-consent-button analytics-consent-button-secondary" data-consent-choice="necessary">
      Necessary Only
    </button>
    <button type="button" class="analytics-consent-button analytics-consent-button-primary" data-consent-choice="accepted">
      Accept Analytics
    </button>
  </div>
</aside>
