<meta charset="utf-8" />
<title>{{ metaTitle | escape }}</title>
<meta name="description" content="{{ metaDescription | escape }}" />
<meta property="og:title" content="{{ metaTitle | escape }}" />
<meta property="og:description" content="{{ metaDescription | escape }}" />
<meta property="og:url" content="{{ canonicalUrl | escape }}" />
{% if metaImage %}<meta property="og:image" content="{{ metaImage | absoluteUrl | escape }}" />{% endif %}
<meta property="og:type" content="{{ ogType | default('website') }}" />
<meta property="og:locale" content="{{ lang | ogLocale | escape }}" />
{% set localizedContentPair = null %}
{% if translationType and translation_id %}
  {% set localizedContentPair = collections.translationMap[translationType][translation_id] %}
{% endif %}
{% if fixedPageId %}
  {% set fixedPagePair = collections.fixedPageTranslationMap[fixedPageId] %}
{% endif %}
{% if fixedPageId or localizedContentPair %}
  {% for languageCode, language in languages %}
    {% if languageCode != lang and (fixedPageId or localizedContentPair[languageCode]) %}<meta property="og:locale:alternate" content="{{ language.ogLocale | escape }}" />{% endif %}
  {% endfor %}
{% endif %}
<meta name="twitter:title" content="{{ metaTitle | escape }}" />
<meta name="twitter:description" content="{{ metaDescription | escape }}" />
{% if metaImage and not suppressTwitterImage %}<meta name="twitter:image" content="{{ metaImage | absoluteUrl | escape }}" />{% endif %}
<meta name="twitter:card" content="{% if metaImage %}summary_large_image{% else %}summary{% endif %}" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta content="hM_wPrtIn6I409cKvss7abYFWBK-JZDYm_rfmT1WqZ4" name="google-site-verification" />
<link href="/css/normalize.css" rel="stylesheet" type="text/css" />
<link href="/css/webflow.css" rel="stylesheet" type="text/css" />
<link href="/css/igor-mihajlovski-portfolio.webflow.css?v=2" rel="stylesheet" type="text/css" />
<link href="/css/case-studies.css" rel="stylesheet" type="text/css" />
{% if blogStyles %}<link href="/css/blog.css" rel="stylesheet" type="text/css" />{% endif %}
<link href="/css/legal.css?v=1" rel="stylesheet" type="text/css" />
{% if newsletterStyles %}<link href="/css/newsletter.css?v=1" rel="stylesheet" type="text/css" />{% endif %}
<style>
  html.w-mod-js:not(.w-mod-ix3) :is(.top-line, .middle-line, .bottom-line) {
    visibility: hidden !important;
  }

  .language-selector {
    position: relative;
    flex: none;
    margin-left: 12px;
    margin-right: 4px;
    z-index: 2;
  }

  .language-selector--mobile {
    display: none;
  }

  .language-selector-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 54px;
    min-height: 36px;
    border: 1px solid #198cb480;
    border-radius: 4px;
    background: var(--box-cards-backgrouund);
    color: var(--text);
    padding: 8px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .language-selector-trigger:hover,
  .language-selector-trigger:focus-visible,
  .language-selector.is-open .language-selector-trigger {
    border-color: var(--primary-button);
    background: #02244d;
  }

  .language-selector-trigger:focus-visible,
  .language-selector-link:focus-visible {
    outline: 2px solid var(--primary-button);
    outline-offset: 2px;
  }

  .language-selector-chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.16s ease;
  }

  .language-selector.is-open .language-selector-chevron {
    transform: translateY(2px) rotate(225deg);
  }

  .language-selector-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    gap: 2px;
    width: max-content;
    min-width: 112px;
    max-width: calc(100vw - 32px);
    margin: 0;
    padding: 5px;
    border: 1px solid #198cb466;
    border-radius: 6px;
    background: var(--box-cards-backgrouund);
    box-shadow: 0 12px 30px #00000040;
    list-style: none;
  }

  .w-mod-js .language-selector-menu {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }

  .w-mod-js .language-selector.is-open .language-selector-menu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  html:not(.w-mod-js) .language-selector-trigger {
    display: none;
  }

  .language-selector-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 40px;
    border-radius: 4px;
    color: var(--text);
    padding: 9px 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .language-selector-link:hover,
  .language-selector-link:focus-visible {
    background: #198cb426;
  }

  .language-selector-link.is-active {
    background: var(--primary-button);
    color: var(--background);
  }

  .language-selector-current {
    font-size: 0.75rem;
  }

  @media screen and (max-width: 991px) {
    .language-selector--desktop {
      display: none;
    }

    .language-selector--mobile {
      display: block;
      margin-right: 14px;
      margin-left: auto;
    }

    .language-selector-trigger {
      min-width: 58px;
      min-height: 44px;
      padding: 10px 11px;
      font-size: 0.8125rem;
    }

    .language-selector-link {
      min-height: 44px;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-selector-trigger,
    .language-selector-chevron,
    .w-mod-js .language-selector-menu {
      transition: none;
    }
  }
</style>
<link href="https://fonts.googleapis.com" rel="preconnect" />
<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
<script type="text/javascript">
  !(function (o, c) {
    var n = c.documentElement,
      t = " w-mod-";
    ((n.className += t + "js"),
      ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) &&
        (n.className += t + "touch"));
  })(window, document);
</script>
<link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
<link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
<link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
<link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
<link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
<link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
{% if not suppressRssAlternate and lang == 'en' %}<link rel="alternate" type="application/rss+xml" title="Igor Mihajlovski Blog" href="{{ '/blog/feed.xml' | absoluteUrl | escape }}" />{% endif %}
<link href="{{ canonicalUrl | escape }}" rel="canonical" />
{% if fixedPageId %}
  {% for languageCode, language in languages %}
<link rel="alternate" hreflang="{{ language.hreflang | escape }}" href="{{ fixedPageId | localizedUrl(languageCode) | absoluteUrl | escape }}" />
  {% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ fixedPageId | localizedUrl | absoluteUrl | escape }}" />
{% elif localizedContentPair %}
  {% for languageCode, language in languages %}
  {% if localizedContentPair[languageCode] %}
<link rel="alternate" hreflang="{{ language.hreflang | escape }}" href="{{ localizedContentPair[languageCode].url | absoluteUrl | escape }}" />
  {% endif %}
  {% endfor %}
  {% if localizedContentPair.en %}
<link rel="alternate" hreflang="x-default" href="{{ localizedContentPair.en.url | absoluteUrl | escape }}" />
  {% endif %}
{% endif %}
{% if homeSchema %}{% include "includes/home-person-schema.njk" %}{% endif %}
{% include "includes/analytics-consent.njk" %}
{% if turnstile %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}
{% if faqStyles %}
<style>
  .faq-vertical-line {
    transition: opacity 0.3s ease;
  }
  .faq-item.active .faq-vertical-line {
    opacity: 0;
  }
</style>
{% endif %}
