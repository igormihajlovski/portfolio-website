{% macro renderLanguageSelector(variant, languages, lang, fixedPageId, localizedContentPair) %}
  {% set activeLanguageName = languages[lang].uiNameKey | t(lang) %}
  <div class="language-selector language-selector--{{ variant }}" data-language-selector>
    <button
      type="button"
      id="language-selector-trigger-{{ variant }}"
      class="language-selector-trigger"
      aria-expanded="false"
      aria-controls="language-selector-menu-{{ variant }}"
      aria-label="{{ 'languageSwitcher.label' | t(lang) | escape }}: {{ activeLanguageName | escape }}"
    >
      <span class="language-selector-trigger-label" lang="{{ languages[lang].htmlLang | escape }}">{{ languages[lang].shortLabel | escape }}</span>
      <span class="language-selector-chevron" aria-hidden="true"></span>
    </button>
    <ul
      id="language-selector-menu-{{ variant }}"
      class="language-selector-menu"
      aria-labelledby="language-selector-trigger-{{ variant }}"
    >
      {% for languageCode, language in languages %}
        {% if fixedPageId or localizedContentPair[languageCode] %}
          {% set languageName = language.uiNameKey | t(lang) %}
          <li class="language-selector-item">
            <a
              class="language-selector-link{% if languageCode == lang %} is-active{% endif %}"
              href="{% if fixedPageId %}{{ fixedPageId | localizedUrl(languageCode) }}{% else %}{{ localizedContentPair[languageCode].url }}{% endif %}"
              lang="{{ language.htmlLang | escape }}"
              hreflang="{{ language.hreflang | escape }}"
              {% if languageCode == lang %}aria-current="page" aria-label="{{ languageName | escape }}"{% else %}aria-label="{{ 'languageSwitcher.switchTo' | t(lang, { language: languageName }) | escape }}"{% endif %}
            >
              <span>{{ language.shortLabel | escape }}</span>
              {% if languageCode == lang %}<span class="language-selector-current" aria-hidden="true">&#10003;</span>{% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endmacro %}

<div class="contact-widget" data-contact-widget style="position: fixed; right: 20px; bottom: 16px; z-index: 9999">
  <button type="button" class="whatsapp contact-widget-trigger" aria-expanded="false" aria-controls="contact-widget-panel" aria-label="{{ 'contactWidget.openLabel' | t(lang) | escape }}" data-open-label="{{ 'contactWidget.openLabel' | t(lang) | escape }}" data-close-label="{{ 'contactWidget.closeLabel' | t(lang) | escape }}">
    <img src="/images/whatsapp.svg" loading="lazy" width="48" height="48" alt="" class="whatsapp-icon" />
  </button>
  <section id="contact-widget-panel" class="contact-widget-panel" aria-labelledby="contact-widget-title" aria-describedby="contact-widget-description" style="position: absolute; right: 0; bottom: calc(100% + 12px); width: 320px; max-width: calc(100vw - 40px)" hidden>
    <h2 id="contact-widget-title" class="contact-widget-title">{{ 'contactWidget.title' | t(lang) | escape }}</h2>
    <p id="contact-widget-description" class="contact-widget-description">{{ 'contactWidget.description' | t(lang) | escape }}</p>
    <div class="contact-widget-actions">
      <a href="{{ 'contactWidget.whatsappMessage' | t(lang) | whatsappUrl | escape }}" target="_blank" rel="noopener noreferrer" class="contact-widget-action">
        <span class="contact-widget-action-icon contact-widget-action-icon-whatsapp" style="display: inline-flex; width: 36px; height: 36px; min-width: 36px; overflow: hidden" aria-hidden="true"><img src="/images/whatsapp.svg" width="20" height="20" alt="" /></span>
        <span class="contact-widget-action-copy"><span class="contact-widget-action-title">{{ 'contactWidget.whatsappLabel' | t(lang) | escape }}</span><span class="contact-widget-action-subtitle">{{ 'contactWidget.whatsappSubtitle' | t(lang) | escape }}</span></span>
        <span class="contact-widget-action-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a href="tel:+38970265014" class="contact-widget-action">
        <span class="contact-widget-action-icon" style="display: inline-flex; width: 36px; height: 36px; min-width: 36px; overflow: hidden" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.2 3.5 9.4 8 7.8 9.6a14.2 14.2 0 0 0 6.6 6.6l1.6-1.6 4.5 2.2v3a1.5 1.5 0 0 1-1.5 1.5A16.3 16.3 0 0 1 2.7 5a1.5 1.5 0 0 1 1.5-1.5h3Z" /></svg></span>
        <span class="contact-widget-action-copy"><span class="contact-widget-action-title">{{ 'contactWidget.callLabel' | t(lang) | escape }}</span><span class="contact-widget-action-subtitle">{{ 'contactWidget.callSubtitle' | t(lang) | escape }}</span></span>
        <span class="contact-widget-action-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a href="{% if homePage %}#contact{% else %}{{ 'home' | localizedUrl(lang) }}#contact{% endif %}" class="contact-widget-action">
        <span class="contact-widget-action-icon" style="display: inline-flex; width: 36px; height: 36px; min-width: 36px; overflow: hidden" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 5.5h18v13H3z" /><path d="m4 7 8 6 8-6" /></svg></span>
        <span class="contact-widget-action-copy"><span class="contact-widget-action-title">{{ 'contactWidget.emailLabel' | t(lang) | escape }}</span><span class="contact-widget-action-subtitle">{{ 'contactWidget.emailSubtitle' | t(lang) | escape }}</span></span>
        <span class="contact-widget-action-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</div>
{% set localizedContentPair = null %}
{% if translationType and translation_id %}
  {% set localizedContentPair = collections.translationMap[translationType][translation_id] %}
{% endif %}
<div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar w-nav">
  <div class="container nav-container">
    <div class="inner-nav">
      <a href="{{ 'home' | localizedUrl(lang) }}" class="brand w-nav-brand">
        <img src="/images/Logo-Igor-Mihajlovski-Portfolio-Brend.svg" loading="eager" alt="{{ 'header.logoAlt' | t(lang) | escape }}" height="48" class="logo-mobile" />
      </a>
      <nav role="navigation" class="nav-menu w-nav-menu">
        <a href="{% if homePage %}#hero{% else %}{{ 'home' | localizedUrl(lang) }}#hero{% endif %}" class="nav-link w-nav-link">{{ 'nav.home' | t(lang) | escape }}</a>
        <a href="{% if homePage %}#about-me{% else %}{{ 'home' | localizedUrl(lang) }}#about-me{% endif %}" class="nav-link w-nav-link">{{ 'nav.about' | t(lang) | escape }}</a>
        <a href="{{ 'projects' | localizedUrl(lang) }}" class="nav-link w-nav-link">{{ 'nav.projects' | t(lang) | escape }}</a>
        <a href="{{ 'blog' | localizedUrl(lang) }}" class="nav-link w-nav-link">{{ 'nav.blog' | t(lang) | escape }}</a>
        <a href="{% if homePage %}#services{% else %}{{ 'home' | localizedUrl(lang) }}#services{% endif %}" class="nav-link w-nav-link">{{ 'nav.services' | t(lang) | escape }}</a>
        {% if fixedPageId or localizedContentPair %}
          {{ renderLanguageSelector("desktop", languages, lang, fixedPageId, localizedContentPair) }}
        {% endif %}
        <a href="{% if homePage %}#contact{% else %}{{ 'home' | localizedUrl(lang) }}#contact{% endif %}" class="nav-btn w-nav-link">{{ 'nav.contact' | t(lang) | escape }}</a>
      </nav>
      {% if fixedPageId or localizedContentPair %}
        {{ renderLanguageSelector("mobile", languages, lang, fixedPageId, localizedContentPair) }}
      {% endif %}
      <div class="menu-button w-nav-button">
        <div class="hamburger-wrapper">
          <div class="top-line"></div>
          <div class="middle-line"></div>
          <div class="bottom-line"></div>
        </div>
      </div>
    </div>
  </div>
</div>
