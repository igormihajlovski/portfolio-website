<section id="contact" class="contact-section">
  <div class="container">
    <div class="section-name">{{ 'contact.eyebrow' | t(lang) | escape }}</div>
    <div class="contact-wrapper">
      <div class="contact-info">
        <h2>{{ 'contact.heading' | t(lang) | escape }}</h2>
        <p class="contact-paragraph">
          {{ 'contact.description1' | t(lang) | escape }}
        </p>
        <p class="contact-paragraph">
          {{ 'contact.description2' | t(lang) | escape }}
        </p>
        <div class="tag-card-contact-wrapper">
          <div class="tag-card contact-tag">
            <img
              src="/images/Vector-email.svg"
              loading="lazy"
              alt=""
              class="contact-tag-icon"
            />
            <div class="email">igor@igormihajlovski.com</div>
          </div>
          <div class="tag-card contact-tag">
            <img
              src="/images/Vector-time.svg"
              loading="lazy"
              alt=""
              class="contact-tag-icon"
            />
            <div class="email">{{ 'contact.replyTime' | t(lang) | escape }}</div>
          </div>
        </div>
      </div>
      <div class="contact-form">
        <div class="form-block w-form">
          <form
            id="email-form"
            name="email-form"
            data-name="Email Form"
            action="/php/contact.php"
            method="post"
            novalidate
            data-error-fallback="{{ 'contact.errorFallback' | t(lang) | escape }}"
          >
            <label for="name">{{ 'contact.nameLabel' | t(lang) | escape }}</label>

            <input
              class="input-field w-input"
              maxlength="100"
              minlength="2"
              name="name"
              data-name="Name"
              placeholder="{{ 'contact.namePlaceholder' | t(lang) | escape }}"
              type="text"
              id="name"
              required
            />

            <label for="email">{{ 'contact.emailLabel' | t(lang) | escape }}</label>

            <input
              class="input-field w-input"
              maxlength="254"
              name="email"
              data-name="Email"
              placeholder="{{ 'contact.emailPlaceholder' | t(lang) | escape }}"
              type="email"
              id="email"
              required
            />

            <label for="message">{{ 'contact.messageLabel' | t(lang) | escape }}</label>

            <textarea
              required
              placeholder="{{ 'contact.messagePlaceholder' | t(lang) | escape }}"
              minlength="10"
              maxlength="5000"
              id="message"
              name="message"
              data-name="Message"
              class="message-field w-input"
            ></textarea>

            <!-- Honeypot: hidden from real visitors -->
            <div
              aria-hidden="true"
              style="
                position: absolute;
                left: -9999px;
                width: 1px;
                height: 1px;
                overflow: hidden;
              "
            >
              <label for="website">{{ 'contact.websiteLabel' | t(lang) | escape }}</label>

              <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="recaptcha-wrapper">
              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAAEHLlZesFIvNLiGE"
                data-theme="light"
                data-language="{{ lang | escape }}"
              ></div>
            </div>

            <input
              type="submit"
              data-wait="{{ 'contact.waitMessage' | t(lang) | escape }}"
              class="form-btn w-button"
              value="{{ 'contact.submit' | t(lang) | escape }}"
            />
          </form>

          <div class="form-message-sent w-form-done" style="color: #021526">
            <div>
              <strong>{{ 'contact.successHeading' | t(lang) | escape }}</strong><br />
              {{ 'contact.successMessage' | t(lang) | escape }}<br />
              {{ 'contact.successFollowUp' | t(lang) | escape }}
            </div>
          </div>

          <div class="error-message w-form-fail">
            <div class="text-block">
              {{ 'contact.errorMessage' | t(lang) | escape }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
