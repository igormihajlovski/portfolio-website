<section id="portfolio" class="portfolio-section">
  <div class="container">
    <div class="section-name">{{ 'home.portfolio.eyebrow' | t(lang) | escape }}</div>
    <h2>{{ 'home.portfolio.heading' | t(lang) | escape }}</h2>
    <p class="section-paragraph">
      {{ 'home.portfolio.intro' | t(lang) | escape }}
    </p>
    {% set localizedCaseStudies = collections.caseStudiesByLanguage[lang] | default([]) %}
    {% set featuredCaseStudies = localizedCaseStudies | homepageProjects %}
    {% if featuredCaseStudies.length %}
    <div class="card-wrapper cms-project-grid project-count-{{ featuredCaseStudies.length }}">
      {% for project in featuredCaseStudies %}
      <div class="card-portfolio cms-project-card">
        {% if project.data.hero.featured_image %}
        <img
          src="{{ project.data.hero.featured_image | assetUrl | escape }}"
          loading="lazy"
          alt="{{ 'common.caseStudyFeaturedImage' | t(lang, { title: project.data.title }) | escape }}"
          class="portfolio-img--tablet portfolio-img-mobile cms-project-image"
        />
        {% endif %}
        <div class="card-description cms-project-description">
          <h3 class="card-heading">{{ project.data.title | escape }}</h3>
          <p class="card-paragraph">{{ project.data.short_description | escape }}</p>
        </div>
        <div class="tags-button-wrapper cms-project-footer">
          {% if project.data.hero.technologies and project.data.hero.technologies.length %}
          <div class="tags-wrapper cms-project-tags">
            {% for technology in project.data.hero.technologies %}
            <div class="tag-card">
              <img src="/images/Vector-check.svg" loading="lazy" alt="" class="tag-icon" />
              <div>{{ technology | escape }}</div>
            </div>
            {% endfor %}
          </div>
          {% endif %}
          <a href="{{ project.url | escape }}" class="main-btn project-btn w-inline-block">
            <div>{{ 'common.viewCaseStudy' | t(lang) | escape }}</div>
          </a>
        </div>
      </div>
      {% endfor %}
    </div>
    <a href="{{ 'projects' | localizedUrl(lang) }}" class="secondary-btn cms-projects-all-link w-inline-block">{{ 'common.viewAllCaseStudies' | t(lang) | escape }}</a>
    {% else %}
    <p class="section-paragraph empty-state" role="status">{{ 'home.portfolio.emptyState' | t(lang) | escape }}</p>
    <a href="{{ 'projects' | localizedUrl(lang) }}" class="secondary-btn cms-projects-all-link w-inline-block">{{ 'home.portfolio.emptyCta' | t(lang) | escape }}</a>
    {% endif %}
  </div>
</section>
