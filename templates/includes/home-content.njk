<section
  id="newsletter"
  class="newsletter-section"
  aria-labelledby="newsletter-heading"
>
  <div class="container newsletter-container">
    <div class="newsletter-content">
      <div class="section-name newsletter-eyebrow">{{ 'newsletter.eyebrow' | t(lang) | escape }}</div>
      <h2 id="newsletter-heading">{{ 'newsletter.heading' | t(lang) | escape }}</h2>
      <p class="newsletter-intro">
        {{ 'newsletter.intro' | t(lang) | escape }}
      </p>
    </div>
    <form
      class="newsletter-form"
      action="https://igormihajlovski.us1.list-manage.com/subscribe/post?u=186d00000df182149db0c8b71&amp;id=672250aa2d&amp;f_id=0067c2e1f0"
      method="post"
      target="_blank"
      accept-charset="UTF-8"
    >
      <div class="newsletter-field">
        <label for="newsletter-email">{{ 'newsletter.emailLabel' | t(lang) | escape }}</label>
        <input
          id="newsletter-email"
          name="EMAIL"
          type="email"
          placeholder="{{ 'newsletter.emailPlaceholder' | t(lang) | escape }}"
          autocomplete="email"
          maxlength="254"
          required
        />
      </div>

      <div class="newsletter-consent">
        <input
          id="gdpr_364697"
          name="gdpr[364697]"
          type="checkbox"
          value="Y"
          required
        />
        <label for="gdpr_364697">
          <span class="newsletter-consent-title">{{ 'newsletter.consentTitle' | t(lang) | escape }}</span>
          {{ 'newsletter.consentText' | t(lang) | escape }}
        </label>
      </div>

      <p class="newsletter-privacy">
        {{ 'newsletter.privacyBeforeLink' | t(lang) | escape }}
        <a href="{{ 'privacy' | localizedUrl(lang) }}">{{ 'footer.privacyPolicy' | t(lang) | escape }}</a>
        {{ 'newsletter.privacyAfterLink' | t(lang) | escape }}
      </p>
      <p class="newsletter-processing">
        {{ 'newsletter.processing' | t(lang) | escape }}
        <a
          href="https://mailchimp.com/legal/terms/"
          target="_blank"
          rel="noopener noreferrer"
          >{{ 'newsletter.mailchimpPrivacy' | t(lang) | escape }}</a
        >
      </p>

      <div class="newsletter-honeypot" aria-hidden="true">
