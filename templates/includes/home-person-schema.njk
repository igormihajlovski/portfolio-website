<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "Igor Mihajlovski",
    "url": "{{ canonicalUrl }}",
    "image": {
      "@type": "ImageObject",
      "url": "https://cdn.prod.website-files.com/697e45df7d51cf8c3766ddee/69838128ab2a39a999dcde4d_Hero%20image%20with%20mask%20Compressed.png",
      "caption": {{ 'home.schema.imageCaption' | t(lang) | jsonString | safe }}
    },
    "jobTitle": {{ 'home.schema.jobTitle' | t(lang) | jsonString | safe }},
    "description": {{ 'home.schema.description' | t(lang) | jsonString | safe }},
    "email": "mailto:igor@igormihajlovski.com",
    "sameAs": [
      "https://www.linkedin.com/in/igor-mihajlovski-37914a164",
      "https://github.com/igormihajlovski"
    ],
    "knowsAbout": [
      "Webflow Development",
      "Responsive Web Design",
      "Website Design",
      "Web Performance Optimization",
      "CMS Setup",
      "SEO Optimization",
      "Landing Page Development"
    ],
    "hasOccupation": {
      "@type": "Occupation",
      "name": {{ 'home.schema.occupationName' | t(lang) | jsonString | safe }},
      "skills": [
        "Webflow",
        "Figma",
        "Responsive Design",
        "CMS Setup",
        "SEO Optimization",
        "Web Performance"
      ]
    },
    "makesOffer": {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": {{ 'home.schema.serviceName' | t(lang) | jsonString | safe }},
        "serviceType": {{ 'home.schema.serviceType' | t(lang) | jsonString | safe }},
        "description": {{ 'home.schema.serviceDescription' | t(lang) | jsonString | safe }}
      }
    },
    "workExample": [
      {
        "@type": "CreativeWork",
        "name": "Jaeger Immobilien Website",
        "url": "https://www.jaeger-immobilienverwaltung.de/"
      }
    ]
  }
</script>
