{% set localizedProjects = collections.caseStudiesByLanguage[lang] | default([]) %}
{% set projectGroups = localizedProjects | projectGroups %}
<section class="listing-hero">
  <div class="container case-study-copy">
    <div class="section-name">{{ 'projects.eyebrow' | t(lang) | escape }}</div>
    <h1>{{ 'projects.heading' | t(lang) | escape }}</h1>
    <p class="case-study-lede">{{ 'projects.intro' | t(lang) | escape }}</p>
  </div>
</section>
<section class="case-study-section case-study-listing-section">
  <div class="container">
    {% if projectGroups.length %}
      {% for group in projectGroups %}
        {% set firstGroup = loop.first %}
        <section class="case-study-project-group" aria-labelledby="project-group-{{ group.key }}">
          <h2 id="project-group-{{ group.key }}" class="case-study-project-group-heading">{{ ('projectTypes.' ~ group.key) | t(lang) | escape }}</h2>
          <div class="card-wrapper case-study-listing-grid project-count-{{ group.projects.length }}">
            {% for project in group.projects %}
              <article class="card-portfolio case-study-listing-card">
                {% if project.data.hero.featured_image %}
                  <img
                    src="{{ project.data.hero.featured_image | assetUrl | escape }}"
                    loading="{% if firstGroup and loop.first %}eager{% else %}lazy{% endif %}"
                    {% if firstGroup and loop.first %}fetchpriority="high"{% else %}decoding="async"{% endif %}
                    alt="{{ 'common.caseStudyFeaturedImage' | t(lang, { title: project.data.title }) | escape }}"
                    class="portfolio-img--tablet portfolio-img-mobile case-study-listing-image"
                  />
                {% endif %}
                <div class="card-description case-study-listing-content">
                  {% if project.data.category %}<div class="section-name">{{ project.data.category | projectCategoryLabel(lang) | escape }}</div>{% endif %}
                  <h3 class="card-heading">{{ project.data.title | escape }}</h3>
                  {% if project.data.short_description %}<p class="card-paragraph">{{ project.data.short_description | escape }}</p>{% endif %}
                  {% if project.data.published_date %}<time class="case-study-date" datetime="{{ project.data.published_date | htmlDate }}">{{ project.data.published_date | displayDate(lang) }}</time>{% endif %}
                </div>
                <a href="{{ project.url | escape }}" class="main-btn project-btn case-study-listing-button w-inline-block"><span>{{ 'common.viewCaseStudy' | t(lang) | escape }}</span></a>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    {% else %}
      <p class="empty-state" role="status">{{ 'projects.emptyState' | t(lang) | escape }}</p>
    {% endif %}
  </div>
</section>
