---
layout: layouts/base.njk
blogStyles: true
eleventyComputed:
  metaTitle: "{% if seo and seo.title %}{{ seo.title }}{% else %}{{ title }} | Igor Mihajlovski{% endif %}"
  metaDescription: "{% if seo and seo.description %}{{ seo.description }}{% else %}{{ short_description }}{% endif %}"
  metaImage: "{% if seo and seo.og_image %}{{ seo.og_image }}{% else %}{{ featured_image }}{% endif %}"
  canonicalUrl: "https://igormihajlovski.com/blog/{{ slug }}/"
ogType: article
---
<article class="blog-post">
  <header class="blog-post-hero">
    <div class="container blog-post-header">
      {% if category %}<div class="section-name">{{ category | escape }}</div>{% endif %}
      <h1>{{ title | escape }}</h1>
      {% if short_description %}<p class="blog-post-lede">{{ short_description | escape }}</p>{% endif %}
      <div class="blog-post-byline">
        {% if published_date %}<time datetime="{{ published_date | htmlDate }}">{{ published_date | displayDate }}</time>{% endif %}
        {% if author %}<span>By {{ author | escape }}</span>{% endif %}
      </div>
      {% if tags and tags.length %}
        <ul class="blog-post-tags" aria-label="Article tags">
          {% for tag in tags %}<li>{{ tag | escape }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
    {% if featured_image %}
      <div class="container blog-post-featured-media">
        <img src="{{ featured_image | assetUrl | escape }}" alt="{{ (featured_image_alt or (title ~ ' article featured image')) | escape }}" />
      </div>
    {% endif %}
  </header>

  <section class="blog-article-section">
    <div class="container blog-article-shell">
      <div class="blog-article-content">
        {{ article_content | renderMarkdown | safe }}
      </div>
      {% if related_project_url %}
        <aside class="blog-related-project" aria-labelledby="related-project-heading">
          <div class="section-name">Related Case Study</div>
          <h2 id="related-project-heading">Continue exploring the project</h2>
          <a href="{{ related_project_url | escape }}" class="secondary-btn w-inline-block">{{ (related_project_label or "View Related Project") | escape }}</a>
        </aside>
      {% endif %}
    </div>
  </section>
</article>
