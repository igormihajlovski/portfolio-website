---
layout: layouts/base.njk
blogStyles: true
translationType: Blog
eleventyComputed:
  metaTitle: "{% if seo and seo.title %}{{ seo.title }}{% else %}{{ title }} | Igor Mihajlovski{% endif %}"
  metaDescription: "{% if seo and seo.description %}{{ seo.description }}{% else %}{{ short_description }}{% endif %}"
  metaImage: "{% if seo and seo.og_image %}{{ seo.og_image }}{% else %}{{ featured_image }}{% endif %}"
  canonicalUrl: "{{ page.url | absoluteUrl }}"
ogType: article
---
{% set article = article_content | blogArticle %}
<div class="blog-reading-progress" aria-hidden="true"><div class="blog-reading-progress-value" data-blog-reading-progress></div></div>
<article class="blog-post">
  <header class="blog-post-hero">
    <div class="container blog-post-header">
      {% if category %}<div class="section-name">{{ category | escape }}</div>{% endif %}
      <h1>{{ title | escape }}</h1>
      {% if short_description %}<p class="blog-post-lede">{{ short_description | escape }}</p>{% endif %}
      <div class="blog-post-byline">
        {% if published_date %}<time datetime="{{ published_date | htmlDate }}">{{ published_date | displayDate(lang) }}</time>{% endif %}
        <span class="blog-post-reading-time">{{ 'blog.readingTime' | t(lang, { minutes: article.readingMinutes }) | escape }}</span>
        {% if author %}<span>{{ 'blog.byAuthor' | t(lang, { author: author }) | escape }}</span>{% endif %}
      </div>
      {% if tags and tags.length %}
        <ul class="blog-post-tags" aria-label="{{ 'blog.articleTags' | t(lang) | escape }}">
          {% for tag in tags %}<li>{{ tag | escape }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
    {% if featured_image %}
      <div class="container blog-post-featured-media">
        <img
          src="{{ featured_image | assetUrl | escape }}"
          loading="eager"
          fetchpriority="high"
          alt="{{ (featured_image_alt or ('common.articleFeaturedImage' | t(lang, { title: title }))) | escape }}"
        />
      </div>
    {% endif %}
  </header>

  <section class="blog-article-section">
    <div class="container blog-article-shell">
      {% if article.tableOfContents.length >= 4 %}
        <nav class="blog-table-of-contents" aria-label="{{ 'blog.tableOfContentsLabel' | t(lang) | escape }}">
          <h2>{{ 'blog.tableOfContentsHeading' | t(lang) | escape }}</h2>
          <ol>
            {% for item in article.tableOfContents %}
              <li><a href="#{{ item.id | escape }}">{{ item.text | escape }}</a></li>
            {% endfor %}
          </ol>
        </nav>
      {% endif %}
      <div class="blog-article-content" data-blog-reading-region>
        {{ article.html | safe }}
      </div>
      {% if related_project_url %}
        <aside class="blog-related-project" aria-labelledby="related-project-heading">
          <div class="section-name">{{ 'blog.relatedLabel' | t(lang) | escape }}</div>
          <h2 id="related-project-heading">{{ 'blog.relatedHeading' | t(lang) | escape }}</h2>
          <a href="{{ related_project_url | escape }}" class="secondary-btn w-inline-block">{{ (related_project_label or ('blog.relatedCta' | t(lang))) | escape }}</a>
        </aside>
      {% endif %}
    </div>
  </section>
</article>
<script src="/js/blog-reading.js" defer></script>
