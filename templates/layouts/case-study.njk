---
layout: layouts/base.njk
translationType: Project
eleventyComputed:
  metaTitle: "{% if seo.title %}{{ seo.title }}{% else %}{{ title }} | Igor Mihajlovski{% endif %}"
  metaDescription: "{% if seo.description %}{{ seo.description }}{% else %}{{ short_description }}{% endif %}"
  metaImage: "{% if seo.og_image %}{{ seo.og_image }}{% else %}{{ hero.featured_image }}{% endif %}"
  canonicalUrl: "{{ page.url | absoluteUrl }}"
ogType: article
---
<article class="case-study">
  <header class="case-study-hero">
    <div class="container case-study-hero-layout">
      <div class="case-study-hero-heading">
        {% if category %}<div class="section-name">{{ category | projectCategoryLabel(lang) | escape }}</div>{% endif %}
        <h1>{{ title | escape }}</h1>
      </div>
      <div class="case-study-hero-grid">
        <div class="case-study-hero-copy">
        {% if hero.subtitle %}<p class="case-study-lede">{{ hero.subtitle | escape }}</p>{% endif %}
        {% if published_date %}<time class="case-study-date" datetime="{{ published_date | htmlDate }}">{{ published_date | displayDate(lang) }}</time>{% endif %}
        {% if (hero.services and hero.services.length) or (hero.technologies and hero.technologies.length) %}
          <div class="case-study-meta-groups">
            {% if hero.services and hero.services.length %}
              <div>
                <div class="case-study-tag-label">{{ 'caseStudy.services' | t(lang) | escape }}</div>
                <div class="case-study-tags">{% for service in hero.services %}<span class="tag-card">{{ service | escape }}</span>{% endfor %}</div>
              </div>
            {% endif %}
            {% if hero.technologies and hero.technologies.length %}
              <div>
                <div class="case-study-tag-label">{{ 'caseStudy.technologies' | t(lang) | escape }}</div>
                <div class="case-study-tags">{% for technology in hero.technologies %}<span class="tag-card">{{ technology | escape }}</span>{% endfor %}</div>
              </div>
            {% endif %}
          </div>
        {% endif %}
        </div>
        <div class="case-study-hero-visual">
          {% if hero.featured_image %}
            <div class="case-study-hero-media">
              <img
                class="case-study-featured-image"
                src="{{ hero.featured_image | assetUrl | escape }}"
                loading="eager"
                fetchpriority="high"
                alt="{{ 'common.caseStudyFeaturedImage' | t(lang, { title: title }) | escape }}"
              />
            </div>
          {% endif %}
          {% if project_links and project_links.live_url %}
            <div class="case-study-buttons case-study-hero-actions">
              <a href="{{ project_links.live_url | escape }}" target="_blank" rel="noopener noreferrer" class="main-btn w-inline-block">{{ (project_links.live_button_text or ('common.viewProject' | t(lang))) | escape }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  {% set info = project_information %}
  {% if info and (info.client or info.industry or info.country or info.business_type or info.platform or info.cms or info.duration or info.website) %}
    <section class="case-study-section case-study-section-alt">
      <div class="container">
        <div class="section-name">{{ 'caseStudy.projectInformation' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.projectInformation' | t(lang) | escape }}</h2>
        <dl class="project-information-grid">
          {% if info.client %}<div><dt>{{ 'caseStudy.client' | t(lang) | escape }}</dt><dd>{{ info.client | escape }}</dd></div>{% endif %}
          {% if info.industry %}<div><dt>{{ 'caseStudy.industry' | t(lang) | escape }}</dt><dd>{{ info.industry | escape }}</dd></div>{% endif %}
          {% if info.country %}<div><dt>{{ 'caseStudy.country' | t(lang) | escape }}</dt><dd>{{ info.country | escape }}</dd></div>{% endif %}
          {% if info.business_type %}<div><dt>{{ 'caseStudy.businessType' | t(lang) | escape }}</dt><dd>{{ info.business_type | escape }}</dd></div>{% endif %}
          {% if info.platform %}<div><dt>{{ 'caseStudy.platform' | t(lang) | escape }}</dt><dd>{{ info.platform | escape }}</dd></div>{% endif %}
          {% if info.cms %}<div><dt>{{ 'caseStudy.cms' | t(lang) | escape }}</dt><dd>{{ info.cms | escape }}</dd></div>{% endif %}
          {% if info.duration %}<div><dt>{{ 'caseStudy.duration' | t(lang) | escape }}</dt><dd>{{ info.duration | escape }}</dd></div>{% endif %}
          {% if info.website %}<div><dt>{{ 'caseStudy.website' | t(lang) | escape }}</dt><dd><a href="{{ info.website | escape }}" target="_blank" rel="noopener noreferrer">{{ info.website | escape }}</a></dd></div>{% endif %}
        </dl>
      </div>
    </section>
  {% endif %}

  {% macro richTextSection(label, heading, value, alternate=false) %}
    {% if value %}
      <section class="case-study-section{% if alternate %} case-study-section-alt{% endif %}">
        <div class="container case-study-copy case-study-narrative">
          <div class="section-name">{{ label | escape }}</div>
          <h2>{{ heading | escape }}</h2>
          <div class="rich-text">{{ value | renderMarkdown | safe }}</div>
        </div>
      </section>
    {% endif %}
  {% endmacro %}

  {{ richTextSection('caseStudy.projectOverview' | t(lang), 'caseStudy.projectOverview' | t(lang), project_overview) }}
  {{ richTextSection('caseStudy.challengeLabel' | t(lang), 'caseStudy.challengeHeading' | t(lang), challenge, true) }}

  {% if goals and goals.length %}
    <section class="case-study-section">
      <div class="container case-study-copy">
        <div class="section-name">{{ 'caseStudy.goalsLabel' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.goalsHeading' | t(lang) | escape }}</h2>
        <ul class="case-study-list case-study-list-grid">{% for goal in goals %}<li>{{ goal | escape }}</li>{% endfor %}</ul>
      </div>
    </section>
  {% endif %}

  {% if my_role and ((my_role.roles and my_role.roles.length) or (my_role.responsibilities and my_role.responsibilities.length)) %}
    <section class="case-study-section case-study-section-alt">
      <div class="container">
        <div class="section-name">{{ 'caseStudy.myRole' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.myRole' | t(lang) | escape }}</h2>
        <div class="case-study-columns role-grid">
          {% if my_role.roles and my_role.roles.length %}<div class="case-study-card"><h3>{{ 'caseStudy.roles' | t(lang) | escape }}</h3><ul class="case-study-list">{% for role in my_role.roles %}<li>{{ role | escape }}</li>{% endfor %}</ul></div>{% endif %}
          {% if my_role.responsibilities and my_role.responsibilities.length %}<div class="case-study-card"><h3>{{ 'caseStudy.responsibilities' | t(lang) | escape }}</h3><ul class="case-study-list">{% for responsibility in my_role.responsibilities %}<li>{{ responsibility | escape }}</li>{% endfor %}</ul></div>{% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {{ richTextSection('caseStudy.myApproach' | t(lang), 'caseStudy.myApproach' | t(lang), my_approach) }}
  {{ richTextSection('caseStudy.designProcess' | t(lang), 'caseStudy.designProcess' | t(lang), design_process, true) }}
  {{ richTextSection('caseStudy.developmentProcess' | t(lang), 'caseStudy.developmentProcess' | t(lang), development_process) }}

  {% set stack = tech_stack %}
  {% if stack and ((stack.development and stack.development.length) or (stack.cms and stack.cms.length) or (stack.libraries and stack.libraries.length) or (stack.integrations and stack.integrations.length) or (stack.tools and stack.tools.length)) %}
    <section class="case-study-section case-study-section-alt">
      <div class="container">
        <div class="section-name">{{ 'caseStudy.techStack' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.techStack' | t(lang) | escape }}</h2>
        <div class="tech-stack-grid">
          {% if stack.development and stack.development.length %}<div class="case-study-card"><h3>{{ 'caseStudy.development' | t(lang) | escape }}</h3><ul class="case-study-list">{% for item in stack.development %}<li>{{ item | escape }}</li>{% endfor %}</ul></div>{% endif %}
          {% if stack.cms and stack.cms.length %}<div class="case-study-card"><h3>{{ 'caseStudy.cms' | t(lang) | escape }}</h3><ul class="case-study-list">{% for item in stack.cms %}<li>{{ item | escape }}</li>{% endfor %}</ul></div>{% endif %}
          {% if stack.libraries and stack.libraries.length %}<div class="case-study-card"><h3>{{ 'caseStudy.libraries' | t(lang) | escape }}</h3><ul class="case-study-list">{% for item in stack.libraries %}<li>{{ item | escape }}</li>{% endfor %}</ul></div>{% endif %}
          {% if stack.integrations and stack.integrations.length %}<div class="case-study-card"><h3>{{ 'caseStudy.integrations' | t(lang) | escape }}</h3><ul class="case-study-list">{% for item in stack.integrations %}<li>{{ item | escape }}</li>{% endfor %}</ul></div>{% endif %}
          {% if stack.tools and stack.tools.length %}<div class="case-study-card"><h3>{{ 'caseStudy.tools' | t(lang) | escape }}</h3><ul class="case-study-list">{% for item in stack.tools %}<li>{{ item | escape }}</li>{% endfor %}</ul></div>{% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if third_party_integrations and third_party_integrations.length %}
    <section class="case-study-section">
      <div class="container">
        <div class="section-name">{{ 'caseStudy.integrations' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.thirdPartyIntegrations' | t(lang) | escape }}</h2>
        <div class="case-study-columns integration-grid">
          {% for integration in third_party_integrations %}
            {% if integration.name or integration.purpose or integration.website %}
              <div class="case-study-card integration-card">
                {% if integration.name %}<h3>{{ integration.name | escape }}</h3>{% endif %}
                {% if integration.purpose %}<p>{{ integration.purpose | escape }}</p>{% endif %}
                {% if integration.website %}<a class="integration-link" href="{{ integration.website | escape }}" target="_blank" rel="noopener noreferrer">{{ 'caseStudy.visitWebsite' | t(lang) | escape }}</a>{% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if key_features and key_features.length %}
    <section class="case-study-section case-study-section-alt">
      <div class="container case-study-copy">
        <div class="section-name">{{ 'caseStudy.keyFeatures' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.keyFeatures' | t(lang) | escape }}</h2>
        <ul class="case-study-list case-study-list-grid">{% for item in key_features %}<li>{{ item | escape }}</li>{% endfor %}</ul>
      </div>
    </section>
  {% endif %}

  {% if deliverables and deliverables.length %}
    <section class="case-study-section">
      <div class="container case-study-copy">
        <div class="section-name">{{ 'caseStudy.deliverablesLabel' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.deliverablesHeading' | t(lang) | escape }}</h2>
        <ul class="case-study-list case-study-list-grid">{% for item in deliverables %}<li>{{ item | escape }}</li>{% endfor %}</ul>
      </div>
    </section>
  {% endif %}

  {{ richTextSection('caseStudy.results' | t(lang), 'caseStudy.results' | t(lang), results, true) }}
  {{ richTextSection('caseStudy.lessonsLearned' | t(lang), 'caseStudy.lessonsLearned' | t(lang), lessons_learned) }}

  {% if gallery and gallery.length %}
    <section class="case-study-section case-study-section-alt">
      <div class="container">
        <div class="section-name">{{ 'caseStudy.galleryLabel' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.galleryHeading' | t(lang) | escape }}</h2>
        <div class="gallery-grid">
          {% for item in gallery %}
            {% if item.image %}
              <figure class="gallery-item">
                <img src="{{ item.image | assetUrl | escape }}" alt="{{ (item.alt or item.title or title) | escape }}" loading="lazy" decoding="async" />
                {% if item.caption %}<figcaption>{{ item.caption | escape }}</figcaption>{% endif %}
              </figure>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% set links = project_links %}
  {% if links and (links.live_url or links.github_url or links.demo_url) %}
    <section class="case-study-section case-study-links-section">
      <div class="container case-study-copy case-study-cta">
        <div class="section-name">{{ 'caseStudy.linksLabel' | t(lang) | escape }}</div>
        <h2>{{ 'caseStudy.linksHeading' | t(lang) | escape }}</h2>
        <div class="case-study-buttons">
          {% if links.live_url %}<a href="{{ links.live_url | escape }}" target="_blank" rel="noopener noreferrer" class="main-btn w-inline-block">{{ (links.live_button_text or ('common.viewProject' | t(lang))) | escape }}</a>{% endif %}
          {% if links.github_url %}<a href="{{ links.github_url | escape }}" target="_blank" rel="noopener noreferrer" class="secondary-btn w-inline-block">{{ (links.github_button_text or ('common.viewSourceCode' | t(lang))) | escape }}</a>{% endif %}
          {% if links.demo_url %}<a href="{{ links.demo_url | escape }}" target="_blank" rel="noopener noreferrer" class="secondary-btn w-inline-block">{{ (links.demo_button_text or ('common.viewDemo' | t(lang))) | escape }}</a>{% endif %}
        </div>
      </div>
    </section>
  {% endif %}
</article>
